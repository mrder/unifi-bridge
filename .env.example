# Copy this to .env and fill in your values.

# Which switch to bridge. See switch_profiles.py for the full list and what
# each one assumes (factory-default IP/credentials, which UniFi model it's
# impersonated as).
SWITCH_MODEL=dlink-dgs1250-28x

# Optional -- override the switch's assumed factory-default IP/credentials.
# Leave unset to use switch_profiles.py's defaults for SWITCH_MODEL.
#SWITCH_IP=10.90.90.90
#SWITCH_USERNAME=admin
#SWITCH_PASSWORD=admin

# Your UniFi Network Application's host/IP and inform port (8080 is the
# UniFi default; only change if you've reconfigured your controller).
CONTROLLER_HOST=192.168.1.10
CONTROLLER_PORT=8080

# Usually fine as-is.
#BROADCAST_ADDR=255.255.255.255
#INFORM_INTERVAL=30
#DISCOVERY_INTERVAL=10
#STATE_FILE=/data/bridge_state.json
